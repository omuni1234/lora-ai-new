ARG BASE_IMAGE=lorasim-research:local
FROM ${BASE_IMAGE}
COPY tests /app/tests
RUN python3 -m pip install --user pytest httpx && python3 -m pytest -q /app/tests -p no:cacheprovider

RUN lorasim import-examples --data /tmp/lorasim-profile-smoke \
    && lorasim validate examples/05-adr-energy.yaml \
    && lorasim validate examples/06-badr-mobility.yaml \
    && lorasim run examples/09-fast-multicore.yaml --output /tmp/lorasim-multicore > /tmp/lorasim-multicore.log \
    && lorasim run examples/10-random-waypoints.yaml --output /tmp/lorasim-waypoints > /tmp/lorasim-waypoints.log \
    && lorasim run examples/11-paper-selectors.yaml --output /tmp/lorasim-papers > /tmp/lorasim-papers.log

RUN lorasim run examples/12-sf-ch-comparison.yaml --output /tmp/lorasim-sema > /tmp/lorasim-sema.log \
    && lorasim run examples/13-markov.yaml --output /tmp/lorasim-markov > /tmp/lorasim-markov.log

RUN lorasim run examples/14-unified-action-space.yaml --output /tmp/lorasim-action-space > /tmp/lorasim-action-space.log

RUN lorasim run examples/15-adr-common-space.yaml --output /tmp/lorasim-adr-common > /tmp/lorasim-adr-common.log

RUN lorasim run examples/16-d-lora-waypoints.yaml --output /tmp/lorasim-d-lora > /tmp/lorasim-d-lora.log \
    && lorasim run examples/17-adr-random-channels.yaml --output /tmp/lorasim-adr-hopping > /tmp/lorasim-adr-hopping.log
