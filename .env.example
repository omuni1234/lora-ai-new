LORASIM_WORKERS=2
LORASIM_PORT=8000
LORASIM_API_TOKEN=
LORASIM_ALLOW_PLUGINS=0

# AI consultant: OpenAI by default. Set both model and API key to enable sending.
# GUI settings take priority. API_TYPE: responses or chat_completions.
# Use a model available to your API project with the selected API.
# Keep the key on the server; do not put it in a simulation profile.
LORASIM_AI_BASE_URL=https://api.openai.com/v1
LORASIM_AI_API_TYPE=chat_completions
LORASIM_AI_MODEL=
LORASIM_AI_API_KEY=
LORASIM_AI_MAX_TOKENS=2000
LORASIM_AI_TIMEOUT_S=180
